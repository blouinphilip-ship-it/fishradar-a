# ─── Core (local dev defaults work with docker-compose.yml) ───────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fishradar
REDIS_URL=redis://localhost:6379

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (FREE)
AUTH_SECRET=
# Behind a proxy / on localhost production builds, Auth.js must trust the Host header.
AUTH_TRUST_HOST=true
# Dev-only "sign in as test angler" button (ignored in production builds unless DEMO_MODE=true).
ENABLE_DEV_LOGIN=true
# Public demo server only: allow the test-angler login in a production build. NEVER on a real site.
DEMO_MODE=false
# Google OAuth — FREE. https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Sign in with Apple — needs a PAID Apple Developer account ($99/yr). https://developer.apple.com
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Email magic links via Resend — FREE tier (3k emails/mo). https://resend.com/api-keys
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="FishRadar AI <login@yourdomain.com>"

# ─── AI (Phase 4+) ────────────────────────────────────────────────────────────
# Anthropic API — PAID, usage-based. https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL_EXTRACTION=claude-sonnet-5-5
AI_MODEL_ASSISTANT=claude-sonnet-5-5
AI_MODEL_CLASSIFIER=claude-haiku-5-5
AI_DAILY_BUDGET_USD=5

# ─── Globe (Phase 2) ──────────────────────────────────────────────────────────
# Cesium ion token — FREE community tier (terrain + imagery). https://ion.cesium.com/tokens
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# ─── Conditions (Phase 3) — NO KEYS NEEDED ───────────────────────────────────
# NOAA CO-OPS, NOAA NDBC, NOAA CoastWatch ERDDAP, USGS Water Services, Open-Meteo: free, no key.
# NWS api.weather.gov: free, no key, but requires a User-Agent with contact info.
NWS_USER_AGENT="FishRadarAI/0.1 (contact: you@yourdomain.com)"

# ─── Reports & media (Phase 4) ────────────────────────────────────────────────
# YouTube Data API v3 — FREE (10k units/day quota). https://console.cloud.google.com
YOUTUBE_API_KEY=
# Reddit API — FREE for non-commercial low volume; commercial use needs Reddit approval. https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
